<resources>
    <style name="AppTheme" parent="PausaBase" />
    <style name="PausaBase" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:colorControlNormal">@color/text_muted</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:buttonStyle">@style/PausaButton</item>
        <item name="android:alertDialogTheme">@style/PausaDialog</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>
    <style name="PausaButton" parent="@android:style/Widget.Material.Light.Button">
        <item name="android:stateListAnimator">@animator/button_press</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="PausaDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@drawable/card_background</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
    </style>
    <style name="PausaSheetMotion">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
    <!-- A frosted pill of the notification panel (notification_panel.xml). -->
    <style name="NotificationPanelButton">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/notif_button</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFF8F5ED</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
