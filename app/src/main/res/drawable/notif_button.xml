<?xml version="1.0" encoding="utf-8"?>
<!-- Pill for the buttons of the notification panel: a frosted chip over the sky. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#47FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26FFFCF6" />
            <stroke android:width="1dp" android:color="#40FFFCF6" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
