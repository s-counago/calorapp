<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Health Connect (Android 14+): what the Pixel Watch writes there, read only. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />

    <application
        android:name=".PausaApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Compartir → «Pausa · Cajón»: saves what was shared to the cajón without opening the app. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/share_cajon"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BankBrowserActivity"
            android:exported="false" />

        <activity
            android:name=".TradeRepublicActivity"
            android:exported="false" />

        <activity android:name=".AbancaArchiveActivity" android:exported="false" />
        <activity android:name=".BankingImportActivity" android:exported="false" />
        <activity android:name=".CalendarConnectionActivity" android:exported="false" />
        <activity android:name=".CloudActivity" android:exported="false" />
        <activity android:name=".DiagnosticsActivity" android:exported="false" />
        <activity android:name=".HealthPrivacyActivity" android:exported="false" />
        <!-- Health Connect opens this to show why Pausa reads health data; required before it grants access. -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HealthPrivacyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <service android:name=".CalendarSyncJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />

        <activity
            android:name=".RenfeAutomationActivity"
            android:exported="false" />

        <receiver
            android:name=".CalorieActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".DailyTaskResetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
