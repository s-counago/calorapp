  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "vitest": "~4.1.0",
    "wrangler": "4.151.0"
  }
}
